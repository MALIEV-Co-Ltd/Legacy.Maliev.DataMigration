<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);IDE0130</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SourceUnicodeProviderWitness/SourceUnicodeProviderWitness.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="../SourceUnicodeProviderWitness/UnicodeEvidence.cs" Link="SourceUnicodeWitness/UnicodeEvidence.cs" />
    <None Include="../SourceUnicodeProviderWitness/source-bindings.json" Link="SourceUnicodeWitness/source-bindings.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../src/Legacy.Maliev.DataMigration/Legacy.Maliev.DataMigration.csproj" />
    <ProjectReference Include="../../src/Legacy.Maliev.DataMigration.SqlServer/Legacy.Maliev.DataMigration.SqlServer.csproj" />
    <ProjectReference Include="../../src/Legacy.Maliev.DataMigration.Console/Legacy.Maliev.DataMigration.Console.csproj" />
    <ProjectReference Include="../Legacy.Maliev.DataMigration.Tests/Legacy.Maliev.DataMigration.Tests.csproj" />
    <None Include="../../database-disposition.json" Link="database-disposition.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Legacy.Maliev.DataMigration.Tests/Fixtures/SourceScripts/*.sql" Link="Fixtures/SourceScripts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Legacy.Maliev.DataMigration.Tests/Fixtures/Quotation/*.sql" Link="Fixtures/Quotation/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopySourceUnicodeProviderWitness" AfterTargets="Build">
    <ItemGroup>
      <SourceUnicodeWitnessFiles Include="../SourceUnicodeProviderWitness/bin/$(Configuration)/net10.0/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(SourceUnicodeWitnessFiles)" DestinationFiles="@(SourceUnicodeWitnessFiles->'$(TargetDir)source-ef-8.0.28/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
